    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst offers = items.map(item => {\n  \n  const raw = item.json.text;\n  const data = typeof raw === \"string\" ? JSON.parse(raw) : raw;\n\n  let expectedRevenue = Number(data.expected_revenue);\n  if (!expectedRevenue || expectedRevenue <= 0) {\n    expectedRevenue = 1000;\n  }\n\n  let buId = Number(data.business_unit_id);\n  if (!buId || ![2,3,4,5].includes(buId)) {\n    buId = 3;\n  }\n\n  return {\n    name: data.name || \"\",\n    contact_name: data.contact_name || \"\",\n    email_from: data.email_from || \"\",\n    email_cc: data.email_cc || \"\",\n    phone: data.phone || \"\",\n    function: data.function || \"\",\n    street: data.street || \"\",\n    city: data.city || \"\",\n    zip: data.zip || \"\",\n    website: data.website || \"\",\n    date_deadline: data.date_deadline || \"\",\n    expected_revenue: expectedRevenue,\n    country_id: 76,\n    user_id: 2,\n    team_id: 1,\n    partner_id: 1,\n    business_unit_id: buId,\n    probability: 50,\n    Mode_de_livraison: \"01 Forfait\",\n    piste_source_id: $('Webhook').first().json.body.id  // ✅ AJOUTÉ\n  };\n});\n\nreturn [\n  {\n    json: {\n      offers: offers\n    }\n  }\n];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1312,
        -736
      ],
      "id": "acbf8d22-89fc-494e-84bc-499abc0ad7cf",
      "name": "Code in JavaScript3"
    },
    {
      "parameters": {
        "promptType": "define",
        "text": "=Tu es un extracteur expert des avis d’attribution BOAMP.\n\nAnalyse les texte fourni et retourne UNIQUEMENT des JSON valide (sans markdown, sans backticks, sans explication).\n\nRespecte STRICTEMENT ces règles :\n\nAucune phrase hors JSON\n\nAucun commentaire\n\nAucun champ supplémentaire\n\nSi une donnée est absente → mettre une chaîne vide \"\"\n\nexpected_revenue doit être un nombre (sans espace, sans €, sans texte)\n\ndate_deadline format obligatoire YYYY-MM-DD\n\nphone doit contenir uniquement 10 chiffres sans espace\n\nzip doit contenir exactement 5 chiffres\n\nstreet ne doit PAS contenir le code postal ni la ville\n\nwebsite doit être une URL complète commençant par http\n\nLe champ business_unit_id doit être rempli automatiquement selon le type de marché :\n\n2 → Studia/Solutions : services IT, maintenance, solutions génériques\n\n3 → Studia/Digital : digital, web, application, plateforme, logiciel, e-commerce\n\n4 → Studia/Ingénierie : ingénierie, conception, construction, infrastructure, études techniques\n\n5 → Studia/Conseils : audit, conseil, stratégie, accompagnement, formation, assistance\n\nStructure attendue :\n{\n\"name\": \"objet complet du marché\",\n\"contact_name\": \"nom organisme acheteur seulement\",\n\"email_from\": \"email acheteur\",\n\"email_cc\": \"email titulaire\",\n\"phone\": \"telephone 10 chiffres\",\n\"function\": \"poste contact titulaire\",\n\"street\": \"rue acheteur sans CP ni ville\",\n\"city\": \"ville acheteur\",\n\"zip\": \"code postal 5 chiffres acheteur\",\n\"website\": \"URL profil acheteur complete\",\n\"date_deadline\": \"YYYY-MM-DD\",\n\"expected_revenue\": 0,\n\"titulaire\": \"nom du titulaire\",\n\"adresse_titulaire\": \"adresse complete titulaire\",\n\"business_unit_id\": 0\n}\n\nTexte :\n{{ $json.text }}",
        "batching": {}
      },
